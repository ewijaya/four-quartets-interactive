{
  "name": "still-point",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive, annotated reading experience for T. S. Eliot's Four Quartets.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/index-search.ts && tsx scripts/check-dist.ts",
    "build:hosted": "STILLPOINT_PUBLIC=0 STILLPOINT_TEXT=private STILLPOINT_PUBLISH_TEXT=1 npm run build",
    "deploy": "npm run build:hosted && wrangler pages deploy dist --project-name four-quartets-interactive --branch main --commit-dirty=true",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "import-text": "tsx scripts/import-text.ts",
    "pack:hosted": "tsx scripts/pack-hosted-text.ts",
    "make-sample": "tsx scripts/make-sample.ts",
    "resolve-anchors": "tsx scripts/resolve-anchors.ts",
    "coverage": "tsx scripts/coverage.ts",
    "shoot": "tsx scripts/shoot.ts",
    "stills": "tsx scripts/render-stills.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "contrast": "tsx scripts/check-contrast.ts",
    "derive-shape": "tsx scripts/derive-shape.ts",
    "sync-hints": "tsx scripts/sync-hints.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "astro": "^7.3.5",
    "d3-drag": "^3.0.0",
    "d3-ease": "^3.0.1",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "gsap": "^3.15.0",
    "roughjs": "^4.6.6",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "lighthouse": "^13.5.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0",
    "yaml": "^2.9.1"
  }
}
