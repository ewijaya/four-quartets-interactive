---
/** A place's hand-drawn sketch, rendered at build time (rough.js generator → SVG paths). */
import { SKETCH_VIEWBOX, sketchPaths } from "../../lib/viz/sketch";

interface Props {
  sketch: string;
  label: string;
}
const { sketch, label } = Astro.props;
const paths = sketchPaths(sketch);
---

<svg class="sketch" viewBox={SKETCH_VIEWBOX} role="img" aria-label={label}>
  {paths.map((p) => <path d={p.d} class:list={[`sk-s-${p.stroke}`, `sk-f-${p.fill}`]} stroke-width={p.width.toFixed(2)} />)}
</svg>
