---
import { sourceUrl } from "../../lib/url";
import { citeLabel as label } from "../../lib/cite";
import type { Citation } from "../../lib/model";

interface Props {
  items: Citation[];
  /** Where these citations sit in the poem (a note or a line), for the Sources page's way back. */
  from?: string;
}
const { items, from } = Astro.props;
---

{
  items.length > 0 && (
    <p class="citations">
      <span class="citations__label">Sources</span>
      {items.map((c, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={sourceUrl(c.ref, from)} class="citations__item">{label(c) + (c.locator ? `, ${c.locator}` : "")}</a>
          {c.status === "to-verify" && (
            <span class="to-verify" title="Locator not yet verified against the source">
              <span aria-hidden="true">†</span>
              <span class="sr-only">(locator to be verified)</span>
            </span>
          )}
          {c.note && <span class="citations__note"> ({c.note})</span>}
        </>
      ))}
    </p>
  )
}
