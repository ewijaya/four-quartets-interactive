---
/**
 * The four alchemical element signs, set in a circle. Decorative by default;
 * pass `label` to expose it as an image.
 */
import type { Element } from "../../lib/model";

interface Props {
  element: Element | "still";
  size?: number | string;
  label?: string;
  class?: string;
}
const { element, size = 28, label, class: cls = "" } = Astro.props;
const up = element === "air" || element === "fire";
const bar = element === "air" || element === "earth";
// Triangle inscribed in r=17 circle centred at 24,24
const tri = up ? "24,9.5 37,32.5 11,32.5" : "24,38.5 37,15.5 11,15.5";
const barY = up ? 24.5 : 23.5;
---

<svg
  class:list={["emblem", `emblem--${element}`, cls]}
  viewBox="0 0 48 48"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <circle cx="24" cy="24" r="21.5" fill="none" stroke="currentColor" stroke-width="1.1" opacity="0.55"></circle>
  {
    element === "still" ? (
      <>
        <circle cx="24" cy="24" r="12" fill="none" stroke="currentColor" stroke-width="1" opacity="0.8" />
        <circle cx="24" cy="24" r="3.2" fill="currentColor" />
      </>
    ) : (
      <>
        <polygon points={tri} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        {bar && <line x1="15" x2="33" y1={barY} y2={barY} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />}
      </>
    )
  }
</svg>
