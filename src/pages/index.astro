---
import Base from "../layouts/Base.astro";
import Emblem from "../components/chrome/Emblem.astro";
import { QUARTETS } from "../data/quartets";
import { quartetUrl } from "../lib/url";
---

<Base title="Four Quartets" scene="home" bodyClass="is-home">
  <section class="home">
    <h1 class="home__title">Four Quartets</h1>
    <nav aria-label="Choose a quartet" class="home__nav">
      <ol>
        {
          QUARTETS.map((q) => (
            <li data-element={q.element}>
              <a href={quartetUrl(q.id)}>
                <Emblem element={q.element} size={22} />
                <span class="t">{q.title}</span>
                <span class="m">{q.year} · {q.element}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>
</Base>

<style>
  .home {
    min-height: 100svh;
    display: grid;
    place-content: center;
    gap: 2rem;
    text-align: center;
    padding: 6rem 1rem;
  }
  .home__title {
    font-size: clamp(3rem, 2rem + 5vw, 6rem);
    font-weight: 300;
  }
  .home__nav ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .home__nav a {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    padding: 0.75rem 1.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .home__nav .emblem {
    color: var(--accent);
  }
  .home__nav .t {
    font-family: var(--font-display-stack);
    font-size: 1.9rem;
  }
  .home__nav .m {
    font-size: 0.8rem;
    color: var(--ink-faint);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.14em;
  }
</style>
