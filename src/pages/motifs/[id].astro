---
import Base from "../../layouts/Base.astro";
import MotifTracer from "../../components/viz/MotifTracer.astro";
import { MOTIFS } from "../../data/motifs";
import { getNotes } from "../../lib/reader-model";
import { QUARTET_BY_CODE, ROMAN } from "../../data/quartets";
import { noteUrl, url } from "../../lib/url";
import type { MotifId } from "../../lib/model";
import "../../styles/viz.css";

export function getStaticPaths() {
  return MOTIFS.map((m) => ({ params: { id: m.id }, props: { id: m.id } }));
}
const { id } = Astro.props as { id: MotifId };
const motif = MOTIFS.find((m) => m.id === id)!;
const notes = (await getNotes()).filter((n) => n.meta.motifs.includes(id));
---

<Base title={`${motif.name} — motif`} description={motif.gloss} section="motifs">
  <div class="page viz-page" data-pagefind-body data-pagefind-meta={`title:${motif.name} (motif)`}>
    <span data-pagefind-filter="kind:Motif" hidden></span>
    <p class="eyebrow"><a href={url("/motifs")}>Motif Tracer</a></p>
    <h1 style={`--motif:${motif.color}`}><span class="motif-title-dot" aria-hidden="true"></span>{motif.name}</h1>
    <p class="lede">{motif.gloss}</p>
    <MotifTracer initial={[id]} chooser={false} lists={[id]} />
    {
      notes.length > 0 && (
        <section class="motif-notes" aria-labelledby="mn">
          <h2 id="mn">Notes touching on this motif</h2>
          <ul>
            {notes.map((n) => (
              <li>
                <a href={noteUrl(n.meta.id)}>{n.meta.title}</a>
                <span class="muted">
                  {" "}
                  — {QUARTET_BY_CODE[n.meta.anchor.quartet].title}
                  {n.meta.anchor.movement ? ` ${ROMAN[n.meta.anchor.movement]}` : ""}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
